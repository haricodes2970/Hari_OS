{
  "name": "hari-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:check": "node --conditions=react-server scripts/db-check.mjs",
    "db:setup": "node --conditions=react-server scripts/db-setup.mjs",
    "db:test": "node --conditions=react-server scripts/schema-test.mjs",
    "domain:test": "node scripts/domain-test.mjs",
    "contract:test": "node scripts/contract-test.mjs",
    "exec:test": "node --conditions=react-server scripts/exec-test.mjs",
    "app:test": "node --conditions=react-server scripts/app-test.mjs",
    "parser:test": "node --conditions=react-server --import ./scripts/register-alias.mjs scripts/parser-test.mjs",
    "chat:test": "node --conditions=react-server --import ./scripts/register-alias.mjs scripts/chat-test.mjs",
    "kitchen:test": "node --conditions=react-server --import ./scripts/register-alias.mjs scripts/kitchen-test.mjs",
    "expenses:test": "node --conditions=react-server --import ./scripts/register-alias.mjs scripts/expenses-test.mjs",
    "dashboard:test": "node --conditions=react-server --import ./scripts/register-alias.mjs scripts/dashboard-test.mjs",
    "routine:test": "node --conditions=react-server --import ./scripts/register-alias.mjs scripts/routine-test.mjs",
    "skills:test": "node --conditions=react-server --import ./scripts/register-alias.mjs scripts/skills-test.mjs",
    "skills:accept": "node scripts/skills-accept.mjs",
    "dashboard:accept": "node scripts/dashboard-accept.mjs",
    "routine:accept": "node scripts/routine-accept.mjs",
    "responsive:check": "node scripts/responsive-check.mjs",
    "architecture:probe": "node scripts/architecture-probe.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "next": "16.3.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "prettier": "^3.9.9",
    "typescript": "^5"
  }
}
