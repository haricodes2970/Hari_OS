# Hari OS — example environment file
#
# Copy to `.env.local` if you need to override anything locally:
#
#   cp .env.example .env.local
#
# `.env.local` is git-ignored and must never be committed. This file is tracked
# and must never contain real secrets or machine-specific paths.
#
# Hari OS V1 runs on localhost with no deployment, so this file is currently
# short. Variables are added here only when code actually reads them.

# ---------------------------------------------------------------------------
# HARI_OS_DB_PATH
# ---------------------------------------------------------------------------
# Optional. Leave unset for normal local development.
#
# By default the SQLite database lives at:
#
#   data/hari-os.db
#
# resolved relative to the project root. The directory and file are created
# automatically on first use, so nothing needs to be created by hand.
#
# Set this only to point the app at a different database, for example a
# throwaway file used while testing:
#
#   HARI_OS_DB_PATH=data/hari-os.test.db
#
# A relative value is resolved from the current working directory. Do not
# commit a real local path here, and do not use this to point at a shared or
# production database — V1 has no deployment and no remote database.

# ---------------------------------------------------------------------------
# OpenRouter (Phase 2 — natural-language commands)
# ---------------------------------------------------------------------------
# Both variables are REQUIRED for the chat input to work. There is no default
# model: inventing a model identifier would mean shipping a guess that either
# fails on every parse or works by accident, and nobody would learn it was
# hard-coded. With either missing, the app says which one is missing and the
# structured command forms on /kitchen and /expenses keep working.
#
# These are read only on the server, in src/features/chat/config.ts, which
# imports `server-only`. The value is never sent to the browser, never logged,
# and never included in an error message.

OPENROUTER_API_KEY=

# The model id OpenRouter should use. Any chat model that supports
# structured JSON output will do; the one below is an example of the expected
# format, not a tested default.
OPENROUTER_MODEL=

# Optional overrides. The defaults are shown.
#
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_TIMEOUT_MS=20000
# OPENROUTER_APP_TITLE=Hari OS
# OPENROUTER_APP_URL=http://localhost:3000
